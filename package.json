{
  "name": "@zoharyandrianome/crosshooks",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Typed React hooks with platform adapters for web and React Native.",
  "keywords": [
    "react",
    "react-native",
    "hooks",
    "typescript",
    "pwa",
    "cross-platform",
    "web",
    "mobile"
  ],
  "author": "zohary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoharyAnd/crosshooks.git"
  },
  "homepage": "https://github.com/zoharyAnd/crosshooks#readme",
  "bugs": {
    "url": "https://github.com/zoharyAnd/crosshooks/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "firebase": [
        "./dist/firebase.d.ts"
      ],
      "onesignal": [
        "./dist/onesignal.d.ts"
      ],
      "expo": [
        "./dist/expo.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "import": "./dist/index.native.js",
        "require": "./dist/index.native.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./firebase": {
      "react-native": {
        "types": "./dist/firebase.native.d.ts",
        "import": "./dist/firebase.native.js",
        "require": "./dist/firebase.native.cjs"
      },
      "import": {
        "types": "./dist/firebase.d.ts",
        "default": "./dist/firebase.js"
      },
      "require": {
        "types": "./dist/firebase.d.cts",
        "default": "./dist/firebase.cjs"
      }
    },
    "./onesignal": {
      "react-native": {
        "types": "./dist/onesignal.native.d.ts",
        "import": "./dist/onesignal.native.js",
        "require": "./dist/onesignal.native.cjs"
      },
      "import": {
        "types": "./dist/onesignal.d.ts",
        "default": "./dist/onesignal.js"
      },
      "require": {
        "types": "./dist/onesignal.d.cts",
        "default": "./dist/onesignal.cjs"
      }
    },
    "./expo": {
      "react-native": {
        "types": "./dist/expo.native.d.ts",
        "import": "./dist/expo.native.js",
        "require": "./dist/expo.native.cjs"
      },
      "import": {
        "types": "./dist/expo.d.ts",
        "default": "./dist/expo.js"
      },
      "require": {
        "types": "./dist/expo.d.cts",
        "default": "./dist/expo.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "check:package": "publint && attw --pack .",
    "verify": "pnpm typecheck && pnpm lint:fix && pnpm format && pnpm test:coverage && pnpm build && pnpm check:package && pnpm size",
    "prepublishOnly": "pnpm build",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "expo-notifications": ">=0.27.0",
    "firebase": "^12.0.0",
    "react": ">=16.8.0",
    "react-native": ">=0.60.0",
    "react-native-onesignal": "^5.0.0",
    "react-native-permissions": "^5.0.0",
    "react-onesignal": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-firebase/app": {
      "optional": true
    },
    "@react-native-firebase/messaging": {
      "optional": true
    },
    "expo-notifications": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-onesignal": {
      "optional": true
    },
    "react-native-permissions": {
      "optional": true
    },
    "react-onesignal": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.0.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "expo-notifications": "^57.0.10",
    "firebase": "^12.17.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.0",
    "publint": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.76.9",
    "react-native-onesignal": "^5.5.6",
    "react-native-permissions": "^5.6.1",
    "react-onesignal": "^3.5.6",
    "size-limit": "^11.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
