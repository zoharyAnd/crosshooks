{
  "name": "@zoharyandrianome/crosshooks",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Cross-platform React hooks that work on both web and React Native — typed, tested, zero-config.",
  "keywords": [
    "react",
    "react-native",
    "hooks",
    "typescript",
    "pwa",
    "cross-platform",
    "web",
    "mobile"
  ],
  "author": "zohary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoharyAnd/crosshooks.git"
  },
  "homepage": "https://github.com/zoharyAnd/crosshooks#readme",
  "bugs": {
    "url": "https://github.com/zoharyAnd/crosshooks/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "import": "./dist/index.native.js",
        "require": "./dist/index.native.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "pnpm build",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.0.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.0",
    "publint": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^11.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
