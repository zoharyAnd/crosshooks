{
  "name": "crosshooks",
  "version": "0.0.0",
  "description": "Cross-platform React hooks that work on both web and React Native — typed, tested, zero-config.",
  "keywords": [
    "react",
    "react-native",
    "hooks",
    "typescript",
    "pwa",
    "cross-platform",
    "web",
    "mobile"
  ],
  "author": "zohary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoharyAnd/crosshooks.git"
  },
  "homepage": "https://github.com/zoharyAnd/crosshooks#readme",
  "bugs": {
    "url": "https://github.com/zoharyAnd/crosshooks/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "import": "./dist/index.native.js",
        "require": "./dist/index.native.cjs"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
