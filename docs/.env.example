# Firebase Web client configuration.
# These values are public and may be exposed in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Never add Firebase service-account credentials, private keys, or server API
# keys to NEXT_PUBLIC_* variables. Keep all private credentials server-side.
