
# These values are public and may be exposed in the browser.
# Important note: Never add service-account credentials, private keys, or server API
# keys to NEXT_PUBLIC_* variables. Keep all private credentials server-side.

# Firebase client configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# One signal client configuration
NEXT_PUBLIC_ONESIGNAL_APP_ID=